{# Pre-rendered event card. Mirrors the createEventCard() JS in site/events/index.html #}
<article class="event-shell rounded-2xl p-5 shadow-editorial border border-outline-variant/10 hover:shadow-xl transition-shadow" data-event-record="" data-created-at="{{ created_at }}">
    <div class="flex flex-col gap-4">
        <div>
            <h2 class="font-headline text-2xl font-extrabold text-on-surface mb-2 tracking-tight" data-field="title">{{ title }}</h2>
            <p class="text-sm text-on-surface/78 leading-7 line-clamp-3 mb-3" data-field="description">{{ full_description }}</p>
            {% if show_read_more or has_image %}
            <div class="flex flex-wrap gap-3">
                {%- if show_read_more %}
                <button type="button" class="text-sm font-bold text-primary hover:text-primary-container transition-colors" data-event-read-more data-event-title="{{ title }}" data-event-description="{{ full_description }}">Read more</button>
                {%- endif %}
                {%- if has_image %}
                <button type="button" class="text-sm font-bold text-secondary hover:text-secondary/80 transition-colors" data-event-poster data-event-title="{{ title }}" data-image-url="{{ image_url }}">View poster</button>
                {%- endif %}
            </div>
            {% endif %}
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div class="event-meta-card rounded-2xl px-4 py-4" data-field-group="date">
                <p class="text-[11px] font-bold text-primary/70 uppercase tracking-[0.22em] mb-2">Date</p>
                <p class="text-sm font-bold text-on-surface leading-tight" data-field="date">{{ date }}</p>
            </div>
            <div class="event-meta-card rounded-2xl px-4 py-4" data-field-group="time">
                <p class="text-[11px] font-bold text-primary/70 uppercase tracking-[0.22em] mb-2">Time</p>
                <p class="text-sm font-bold text-on-surface leading-tight" data-field="time">{{ time }}</p>
            </div>
        </div>
        <div class="event-location-card rounded-2xl px-5 py-4" data-field-group="location">
            <p class="text-[11px] font-bold text-secondary/80 uppercase tracking-[0.22em] mb-2">Location</p>
            <p class="text-sm font-semibold text-on-surface leading-6" data-field="location">{{ location }}</p>
        </div>
    </div>
</article>
